<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? "#{yield(:title)} | mini-reserve" : "mini-reserve" %></title>
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="/styles.css">
  </head>

  <body>
    <header class="site-header">
      <%= link_to "mini-reserve", root_path, class: "site-title" %>
      <nav>
        <%= link_to "予約一覧", reservations_path %>
        <%= link_to "新規予約", new_reservation_path, class: "button" %>
      </nav>
    </header>

    <main>
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>" role="status"><%= message %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
