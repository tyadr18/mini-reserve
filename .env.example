# mini-reserve の設定サンプルです。
# 値はすべて任意で、未設定のときは右側のデフォルト値が使われます。
# 使う場合は export するか、direnv などで読み込んでください（このアプリは .env を自動では読みません）。

# 1つの時間枠で受け付ける人数の合計（定員）。デフォルト: 10
SLOT_CAPACITY=10

# 1件の予約で受け付ける人数の上限。デフォルト: 8
MAX_PARTY_SIZE=8

# 予約日時の判定に使うタイムゾーン。デフォルト: Tokyo
APP_TIME_ZONE=Tokyo

# 本番環境（RAILS_ENV=production）でのみ必要です。`bin/rails secret` で生成してください。
# SECRET_KEY_BASE=

# 本番環境のデータベースファイルの場所。デフォルト: storage/production.sqlite3
# DATABASE_PATH=storage/production.sqlite3
